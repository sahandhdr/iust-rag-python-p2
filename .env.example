# =============================================================================
# IUST RAG — Python AI Worker
# کپی کنید به .env و مقادیر را پر کنید. این فایل را با secret واقعی commit نکنید.
# کلیدهای تو در تو با جداکننده __ مطابق pydantic-settings هستند.
# =============================================================================

# --- App ---
APP_NAME=IUST RAG System AI-Worker
DEBUG=false
API_PREFIX=/api/v1

# --- Laravel bridge (server-to-server) ---
# باید با PYTHON_INTERNAL_API_KEY در Laravel یکی باشد
LARAVEL__BASE_URL=http://127.0.0.1:8000
LARAVEL__VERIFY_TOKEN_ENDPOINT=/api/v1/auth/verify-token
LARAVEL__SHARED_STORAGE_PATH=/app/shared_storage
LARAVEL__INTERNAL_API_KEY=change-me-shared-secret

# --- LLM ---
AI__LLM_PROVIDER=gapgpt
AI__LLM_MODEL=gpt-4o-mini
AI__LLM_BASE_URL=https://api.gapgpt.app/v1
AI__LLM_API_KEY=

# --- Embedding (بعد از عوض کردن مدل: wipe + reembed) ---
AI__EMBEDDING_PROVIDER=gapgpt
AI__EMBEDDING_MODEL=text-embedding-3-small
AI__EMBEDDING_BASE_URL=https://api.gapgpt.app/v1
AI__EMBEDDING_API_KEY=

# --- Vision (ask_with_file / تصاویر) ---
AI__VISION_PROVIDER=gapgpt
AI__VISION_MODEL=gpt-4o-mini
AI__VISION_BASE_URL=https://api.gapgpt.app/v1
AI__VISION_API_KEY=

AI__TEMPERATURE=0.3
AI__RETRIEVAL_K=6

# --- Hybrid Search (Qdrant dense + sparse) ---
AI__HYBRID_ENABLED=true
AI__HYBRID_PREFETCH_LIMIT=40
AI__DENSE_VECTOR_NAME=dense
AI__SPARSE_VECTOR_NAME=sparse

# --- Qdrant ---
# یا URL (سرویس جدا) یا path محلی — معمولاً یکی کافی است
DB__QDRANT_URL=http://127.0.0.1:6333
DB__QDRANT_PATH=
DB__QDRANT_COLLECTION=iust_rag_hybrid_v1
DB__MYSQL_DSN=

# --- Ingest / data on disk ---
INGESTION__DATA_DIR=./data
INGESTION__INPUT_DIR=./inputs
INGESTION__CHUNK_SIZE=1000
INGESTION__CHUNK_OVERLAP=200
INGESTION__DEFAULT_STATUS=published

# --- RBAC / document ACL (فیلتر retrieval) ---
RBAC__ACCESS_MODE=or
RBAC__HYBRID_BOTH_MODE=or
RBAC__REQUIRE_PUBLISHED=true
RBAC__PUBLISHED_STATUS_VALUE=published
RBAC__ENABLE_PERMISSION_TAG_MATCH=false
RBAC__SUPPORT_LEGACY_DEPARTMENT=true

#AI__LLM_PROVIDER=ollama
#AI__LLM_MODEL=llama3.2
#AI__LLM_BASE_URL=http://127.0.0.1:11434
#AI__LLM_API_KEY=
#
#AI__EMBEDDING_PROVIDER=ollama
#AI__EMBEDDING_MODEL=nomic-embed-text
#AI__EMBEDDING_BASE_URL=http://127.0.0.1:11434
#AI__EMBEDDING_API_KEY=


# --- Hardening ---
# Comma-separated browser origins (empty = localhost Laravel only when DEBUG=false)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Must match Laravel PYTHON_INTERNAL_API_KEY (min 16 chars in production)
LARAVEL__INTERNAL_API_KEY=change-me-shared-secret-use-long-random